# Brain Gateway Environment Configuration
# =========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or run the interactive setup:
#   ./setup.sh

# =============================================================================
# NETWORK NODES - IP addresses of cluster machines
# =============================================================================

# Replace these with your own LAN/Tailscale addresses. Single-box installs
# can leave the non-Helios nodes empty and disable the corresponding optional
# integrations; the orchestrator already falls back gracefully via service_registry.
#
# Helios - Gateway + Primary LLM + TTS/STT (always-on box)
NODE_HELIOS_IP=10.0.0.10

# Jupiter - optional: monitoring stack (Prometheus, Grafana, Loki, Promtail)
NODE_JUPITER_IP=

# Saturn - optional: reserve GPU capacity (vision, expert reasoning)
NODE_SATURN_IP=

# Home Assistant server (leave empty if no HA)
NODE_HA_IP=

# =============================================================================
# PATHS - File system locations
# =============================================================================

# Root path of the gateway installation — the directory containing this
# .env file. install.sh writes this to your actual clone path automatically.
# Manual installs: set to the absolute path of `pwd` after `git clone`.
# Leave at the default (empty) and Docker bind-mounts will resolve relative
# to wherever `docker compose` is invoked from.
GATEWAY_ROOT_PATH=
# uid/gid the orchestrator container runs as (non-root). Must own the
# bind-mounted state dirs; install.sh / scripts/orchestrator_state_perms.sh
# set these to the installing user. Default 1000.
ORCHESTRATOR_UID=
ORCHESTRATOR_GID=

# User home directory (for volume mounts)
USER_HOME=${HOME}

# RAG data directory (your personal documents corpus)
RAG_BASE=${HOME}/rag/personal

# ChromaDB persistence path
CHROMA_PERSIST=${HOME}/.local/share/chroma/personal_rag

# =============================================================================
# SECRETS - MUST BE SET (no defaults)
# =============================================================================

# API authentication token (required — protects all orchestrator endpoints)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=your-api-token-here

# Dashboard login password (asked for by the web /login form at port 3001).
# install.sh generates a random value; setup.sh prints it at end-of-install.
# Required: while it's empty (or the old placeholder 'changeme') the
# dashboard refuses every login. Set it, then recreate the frontend.
DASHBOARD_TOKEN=

# Host interface the dashboard (port 3001) is published on. 0.0.0.0 = LAN
# (default). 127.0.0.1 when you serve it through a reverse proxy on the same
# box, e.g. `tailscale serve --bg --https=443 http://localhost:3001`.
# FRONTEND_BIND_ADDR=0.0.0.0

# Home Assistant long-lived access token
# Get from: HA > Profile > Long-Lived Access Tokens > Create Token
HA_TOKEN=your-ha-token-here

# Grafana admin password (required — the monitoring compose refuses to start
# without it). Only seeds a fresh grafana.db; to change it later run
# `docker exec grafana grafana cli admin reset-admin-password '<new>'`.
GF_SECURITY_ADMIN_PASSWORD=

# =============================================================================
# SERVICE PORTS - Change only if ports conflict
# =============================================================================

# Orchestrator API port
SERVICE_ORCHESTRATOR_PORT=8888

# Open WebUI port
SERVICE_WEBUI_PORT=80

# TTS service port (Qwen3-TTS)
SERVICE_TTS_PORT=8002

# STT service port (Whisper)
SERVICE_STT_PORT=8003

# Primary model server port (llama.cpp on Helios)
SERVICE_MODEL_PORT=8080

# Wyoming Whisper STT (for voice assistant pipeline)
WYOMING_WHISPER_PORT=10300

# Wyoming Jessica TTS bridge (for voice assistant pipeline)
WYOMING_JESSICA_PORT=10301

# =============================================================================
# MONITORING PORTS
# =============================================================================

# Grafana dashboard
MONITORING_GRAFANA_PORT=3000
# Public URL Grafana builds redirects/links from. Grafana binds 127.0.0.1 only;
# front it with e.g. `tailscale serve --bg --https=3000 http://127.0.0.1:3000`.
GRAFANA_ROOT_URL=https://your-host.your-tailnet.ts.net:3000

# Prometheus
MONITORING_PROMETHEUS_PORT=9090

# Loki log aggregation
MONITORING_LOKI_PORT=3100

# Alertmanager (bound to 127.0.0.1 — reachable in-network as alertmanager:9093)
MONITORING_ALERTMANAGER_PORT=9093

# Shared bearer token for the Helios promtail → loki-push-gw (monitoring stack,
# :3101). Same value goes in Helios's /opt/promtail-helios/.env (chmod 600),
# which runs monitoring/promtail/docker-compose.helios.yml. Empty → every push
# is rejected (403). The gateway only accepts pushes from NODE_HELIOS_IP and
# binds on NODE_JUPITER_IP (loopback if unset). LOKI_PUSH_URL is set on Helios
# only (default http://10.0.0.248:3101/loki/api/v1/push).
LOKI_PUSH_TOKEN=

# Compose profile selector. Comma-separated for multiple. See docs/ENV_VARS.md.
#   models   — run vLLM + Qwen3-TTS + Parakeet STT as containers. A fresh
#              single-box install wants this. (On Helios the model layer runs
#              as host systemd units, so `models` is intentionally left out
#              there to avoid double-starting them.)
#   advanced — operator services: nebula-sync, nut-exporter.
# Default empty leaves only the core stack: orchestrator + open-webui + redis
# + searxng + frontend + wyoming bridges.
COMPOSE_PROFILES=

# Node exporter (system metrics)
MONITORING_NODE_EXPORTER_PORT=9100

# GPU exporter
MONITORING_GPU_EXPORTER_PORT=9400

# Blackbox exporter (HTTP probes)
MONITORING_BLACKBOX_PORT=9115

# =============================================================================
# SERVICE URLS - Derived from above (override if needed)
# =============================================================================

# Primary model (conversation + tools) — Bring Your Own Model.
# Brain Gateway is local-first: point it at any OpenAI-compatible server you
# run. Cloud is an opt-in (see MODEL_BACKEND below). Whatever you choose, your
# stored memory / RAG / reminders stay on this box — only the current turn's
# prompt is sent to the model.
#
# MODEL_BACKEND picks the wire protocol:
#   openai_compatible  (default) — vLLM, Ollama, LM Studio, llama.cpp, etc.
#   anthropic          — Anthropic API (Claude). Needs MODEL_API_KEY.
#   openai             — OpenAI API. Needs MODEL_API_KEY.
MODEL_BACKEND=openai_compatible

# Where the model lives. Examples:
#   http://vllm-primary:8000/v1   compose-internal vLLM (the bundled GPU stack)
#   http://10.0.0.50:11434/v1     Ollama on another box / your Mac (LAN IP)
#   http://host.docker.internal:11434/v1   Ollama on the SAME machine as Docker
#   https://api.anthropic.com     when MODEL_BACKEND=anthropic
#   https://api.openai.com/v1     when MODEL_BACKEND=openai
MODEL_URL=http://vllm-primary:8000/v1

# Model id to request (e.g. qwen2.5:14b for Ollama, claude-haiku-4-5 for
# Anthropic, gpt-4o-mini for OpenAI). For the bundled vLLM stack this MUST
# match VLLM_SERVED_NAME in the model-layer section below.
MODEL_NAME=qwen3.6-27b-int4

# API key — ONLY for cloud backends (or a secured local endpoint). Leave empty
# for local Ollama / LM Studio / vLLM. This file is gitignored as `.env`, so a
# key here is not committed — but you can also keep it out of the repo entirely
# by setting api_key: ${OPENAI_API_KEY} in user_profile.yaml and exporting it.
MODEL_API_KEY=

# Fallback model (used when the primary is unavailable). Optional: leave empty
# if you don't run a second model. Mirrors the four MODEL_* vars above.
FALLBACK_MODEL_BACKEND=openai_compatible
FALLBACK_MODEL_URL=
FALLBACK_MODEL_NAME=Qwen3.5-9B
FALLBACK_MODEL_API_KEY=

# Home Assistant API (leave empty to disable HA integration)
HA_URL=
# Entity ids / fnmatch globs the chat home_assistant tool may never call or
# list (comma-separated), e.g. switch.router_*,switch.*_camera_enabled.
# The Helios plug is always denied.
# HA_TOOL_DENY_ENTITIES=

# -- Helios wake-on-demand (PT-C) --------------------------------------------
# Power-tier the GPU box: wake Helios automatically when chat finds the model
# unreachable, and sleep it on demand — by power-cycling a TP-Link Tapo smart
# plug through Home Assistant (reuses HA_URL / HA_TOKEN). Default OFF; auto-
# disables if HA_URL/HA_TOKEN are unset. Set HELIOS_WAKE_ENABLED=true plus the
# plug + power-sensor entity ids to enable. "Sleep" is a hard power-cut (safe —
# Helios is stateless); wake takes ~2 min to boot the model servers.
HELIOS_WAKE_ENABLED=false
HELIOS_PLUG_ENTITY=switch.helios_monitoring_plug
HELIOS_PLUG_POWER_SENSOR=sensor.helios_monitoring_plug_current_consumption
# Suppress duplicate wakes while Helios boots (seconds).
HELIOS_WAKE_DEBOUNCE_SECONDS=300
# Read-only plug polling (watts + running gauges for the
# HeliosPoweredButUnreachable alert) even while HELIOS_WAKE_ENABLED=false.
# Never turns the plug on/off. Needs HA_URL/HA_TOKEN + the entity ids above.
HELIOS_PLUG_MONITOR_ENABLED=false

# TTS service. Inside the compose network, reach qwen-tts by its service
# DNS name. (On the host these are also bound to 127.0.0.1:8002 / :8003,
# but the orchestrator container's `localhost` is the container itself,
# not the host.)
TTS_URL=http://qwen-tts:8002

# STT service.
STT_URL=http://parakeet-stt:8003

# Orchestrator callback URL — used by Home Assistant + external clients
# (NOT inside-compose) to reach the orchestrator. JESS_LAN_IP is written
# by install.sh to the host's real LAN IP.
ORCHESTRATOR_URL=http://${JESS_LAN_IP:-localhost}:${SERVICE_ORCHESTRATOR_PORT:-8888}

# =============================================================================
# MODEL LAYER  (compose profile: models)
# =============================================================================
# These knobs feed the vllm-primary / qwen-tts / parakeet-stt compose services.
# They only start when COMPOSE_PROFILES includes `models` (see above). Run
# `bash scripts/detect_hardware.sh` for a VRAM-tiered VLLM_MODEL suggestion.

# Host interface the model-layer ports bind to. Default 127.0.0.1 (loopback
# only) — the model APIs are unauthenticated, and the orchestrator reaches
# them over the compose network, not the published port. Set to 0.0.0.0 only
# if you need to hit vLLM/TTS/STT from another machine on your LAN.
MODEL_BIND_ADDR=127.0.0.1

# Primary LLM served by vLLM.
#   24GB tier → Qwen/Qwen3-14B-Instruct-AWQ
#   32/48GB tier → Lorbus/Qwen3.6-27B-int4-AutoRound
VLLM_MODEL=Lorbus/Qwen3.6-27B-int4-AutoRound
VLLM_SERVED_NAME=qwen3.6-27b-int4
# vLLM --quantization. `auto_round` suits the default AutoRound model; use
# `awq` for AWQ models, or `auto` to let vLLM detect from the model config.
VLLM_QUANTIZATION=auto_round
VLLM_MAX_MODEL_LEN=153600
VLLM_GPU_MEM_UTIL=0.93

# vLLM image tag for the vllm-primary container. Pinned, not `latest`: the
# serve flags below are version-sensitive (parsers, --speculative-config,
# --kv-cache-dtype names all moved between releases).
VLLM_IMAGE_TAG=v0.19.1

# Host directory mounted read-only at /models inside vllm-primary, for weights
# you staged by hand instead of letting vLLM pull them from HuggingFace. Point
# VLLM_MODEL at `/models/<dirname>` to serve one.
VLLM_MODELS_DIR=./data/models

# Individual knobs spliced into the VLLM_EXTRA_ARGS default block. Each is
# ignored the moment VLLM_EXTRA_ARGS itself is set to a non-empty value (which
# replaces the whole block). Leaving one EMPTY falls back to its default — to
# drop a flag entirely, override VLLM_EXTRA_ARGS as a whole.
# VLLM_KV_CACHE_DTYPE=fp8_e4m3
# VLLM_MAX_NUM_SEQS=2
# VLLM_TOOL_CALL_PARSER=qwen3_coder
# VLLM_REASONING_PARSER=qwen3
# VLLM_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}
# Multimodal args. Default disables the vision tower to save VRAM. Set to
# `--skip-mm-profiling` to keep vision enabled on a multimodal checkpoint.
# VLLM_MM_ARGS=--language-model-only --skip-mm-profiling

# Passed through to the vllm-primary container. Empty = vLLM's own defaults.
# VLLM_CUDA_ALLOC_CONF=expandable_segments:True
# VLLM_USE_FLASHINFER_SAMPLER=0

# --- Qwen3.8-27B NVFP4 on a single RTX 5090 (opt-in; live on the maintainer's Helios since 2026-09-28)
# Weights staged at /home/labadmin/models/Qwen3.8-27B-NVFP4 (RadixArk, 20.4 GiB).
# Stock vLLM, fp8 KV + MTP, CUDA graphs, 131K context: ~111 tok/s decode and
# clean tool calls on the 5090 (docs/internal/QWEN38_PREP_RESULTS.md). Not the
# 262K 4-bit-KV community config, which needs an unmerged vLLM patch. Needs the
# whole 5090 (move TTS to GPU1 first). Uncomment as a set:
#
# VLLM_IMAGE_TAG=v0.27.1
# VLLM_MODELS_DIR=/home/labadmin/models
# VLLM_MODEL=/models/Qwen3.8-27B-NVFP4
# VLLM_SERVED_NAME=qwen3.8-27b-nvfp4
# VLLM_QUANTIZATION=auto
# VLLM_MAX_MODEL_LEN=131072
# VLLM_CUDA_ALLOC_CONF=expandable_segments:True
# VLLM_USE_FLASHINFER_SAMPLER=0
# VLLM_EXTRA_ARGS=--kv-cache-dtype fp8 --max-num-seqs 2 --tool-call-parser qwen3_xml --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"reasoning_effort":"low"}' --skip-mm-profiling
#
# MODEL_NAME must match VLLM_SERVED_NAME:
# MODEL_NAME=qwen3.8-27b-nvfp4
#
# --- llama.cpp primary (live on the maintainer's Helios since 2026-10-02; replaced the
# vLLM NVFP4 block above). Not a compose service — a host systemd unit, see
# tts/llama-server-primary.service (DavidAU Qwen3.8-27B TURBO Fable Q6_K MTP GGUF +
# mmproj-F16, llama.cpp build 11358, 131K ctx, q8_0 KV, --parallel 1, MTP draft-mtp).
# Leave COMPOSE_PROFILES without `models` so compose does not double-start port 8080,
# and point the orchestrator at the host unit:
#
# MODEL_URL=http://<helios-ip>:8080/v1
# MODEL_NAME=qwen3.8-27b-turbo-q6k
# FALLBACK_MODEL_NAME=qwen3.8-27b-turbo-q6k
# VISION_MODEL_URL=http://<helios-ip>:8080/v1
# VISION_MODEL_NAME=qwen3.8-27b-turbo-q6k
# MODEL_START_CMD=sudo systemctl start llama-server-primary
# MODEL_STOP_CMD=sudo systemctl stop llama-server-primary
# -----------------------------------------------------------------------------

# VRAM tier (24 | 32 | 48) — written by scripts/detect_hardware.sh.
JESS_VRAM_TIER=

# Qwen3-TTS — model downloads from HuggingFace into the model-hf-cache volume.
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# To use a local (non-HuggingFace) TTS model — e.g. a cloning-capable *-Base
# model — set QWEN_TTS_MODEL_DIR to its host directory and QWEN_TTS_MODEL to
# /models/local (its in-container mount point).
# QWEN_TTS_MODEL_DIR=
QWEN_TTS_DTYPE=bfloat16
QWEN_TTS_FLASH_ATTN=false
# Host dir for cloned-voice files (voices.json + reference wavs).
TTS_VOICES_PATH=./data/tts_voices

# Parakeet STT model (downloads from HuggingFace).
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3

# When the model layer runs in compose, point the orchestrator at the
# compose-internal service names instead of host IPs:
#   MODEL_URL=http://vllm-primary:8000/v1
#   TTS_URL=http://qwen-tts:8002
#   STT_URL=http://parakeet-stt:8003

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Model name + fallback name now live in the "Primary model" section near the
# top of this file, alongside MODEL_BACKEND / MODEL_URL / MODEL_API_KEY.

# Embedding model (for RAG and auto-learn)
# After changing, run: python scripts/reindex_rag.py --persist $CHROMA_PERSIST --collection $CHROMA_COLLECTION
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe

# TTS voice name
TTS_VOICE=default
# =============================================================================
# RAG CONFIGURATION
# =============================================================================

# ChromaDB collection name
CHROMA_COLLECTION=personal_rag

# Minimum cosine similarity for RAG results
MIN_COS=0.20

# Maximum number of RAG results to return
TOP_K=25

# =============================================================================
# SSH CONFIGURATION - For remote model server management
# =============================================================================

# Model server IP (defaults to NODE_HELIOS_IP if not set)
# MODEL_SERVER_IP=

# Model server SSH user (matches the account that owns the model service)
MODEL_SSH_USER=

# SSH key path (inside container, mounted from host)
MODEL_SSH_KEY=/home/jess/.ssh/id_ed25519

# Commands to start/stop the model server via SSH (optional)
# MODEL_START_CMD=sudo systemctl start llama-server
# MODEL_STOP_CMD=sudo systemctl stop llama-server

# =============================================================================
# REMINDER CONFIGURATION
# =============================================================================

# Default speaker for voice reminders. May be comma-separated for multi-room
# broadcast (avoids Google Home group issues with soundbars).
REMINDER_SPEAKER=media_player.whole_home

# Default speaker for focus timer audio (Endel)
FOCUS_AUDIO_PLAYER=media_player.whole_home

# Lo-fi stream URL for focus sessions (body doubling audio option)
# FOCUS_AUDIO_LOFI_URL=https://example.com/lofi-stream

# Coffee shop stream URL for focus sessions (body doubling audio option)
# FOCUS_AUDIO_COFFEE_URL=https://example.com/coffee-shop-stream

# Mobile notification target — your HA Companion notify service entity
# (e.g. notify.mobile_app_<your_phone_name>). Leave empty to disable.
MOBILE_NOTIFY=

# Web Push — lockscreen notifications from the dashboard itself (no app or
# account). Each device opts in from /settings → Notifications; tapping a
# notification opens /chat, where reminders/nudges have Done / Snooze.
# Needs the dashboard on HTTPS; iPhone also needs Add to Home Screen first.
# WEBPUSH_SUBJECT is required (mailto: or https://) or Web Push stays off.
# The VAPID key is created on first start (keep it — it's in the backup).
# WEBPUSH_ENABLED=false
# WEBPUSH_SUBJECT=mailto:you@example.com
# WEBPUSH_KEY_PATH=/app/data/webpush_vapid.pem
# WEBPUSH_SHOW_TEXT=true
# WEBPUSH_TTL_SECONDS=3600

# Timezone
TZ=America/Chicago

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================

# Grafana admin username
GF_SECURITY_ADMIN_USER=admin

# Disable user signup
GF_USERS_ALLOW_SIGN_UP=false

# =============================================================================
# AGENTIC SETTINGS
# =============================================================================

# Maximum tool call rounds to prevent infinite loops
MAX_TOOL_ROUNDS=5

# Real token streaming on /v1/chat/completions (vLLM primary only; fallback
# backends stay buffered). Kill switch: set false to restore the old
# chunk-the-finished-string behavior without a code change.
REAL_STREAMING_ENABLED=true

# =============================================================================
# PI-HOLE CONFIGURATION - Focus mode distraction blocking
# =============================================================================

# Pi-hole web interface port (default 8053 to avoid conflicts with Open WebUI)
PIHOLE_WEB_PORT=8053

# Pi-hole admin password (required for API access)
PIHOLE_PASSWORD=your-pihole-password-here

# Pi-hole API URLs (comma-separated for multi-instance). Leave empty to
# disable focus-mode DNS blocking; the orchestrator falls back to a TTS-only
# focus session when this is unset.
PIHOLE_URLS=

# Focus blocking group name in Pi-hole (create this group in Pi-hole admin)
PIHOLE_FOCUS_GROUP=focus_blocklist

# Enable/disable focus site blocking (default: false, matching docker-compose.yml
# and config.py). Only turn on if clients resolve DNS through Pi-hole with no
# secondary resolver, or blocked domains leak. See docs/FOCUS_AND_PIHOLE.md.
FOCUS_BLOCKING_ENABLED=false

# =============================================================================
# SEARXNG CONFIGURATION - Web search via self-hosted meta search engine
# =============================================================================

# SearXNG web interface port
SEARXNG_PORT=8090

# SearXNG API URL (internal Docker network)
SEARXNG_URL=http://searxng:8080

# Maximum number of search results to return per query
SEARXNG_MAX_RESULTS=5

# =============================================================================
# GOOGLE CALENDAR CONFIGURATION
# =============================================================================

# Path to OAuth2 credentials JSON (from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=/app/credentials/google_credentials.json

# Path to saved OAuth2 token (generated by google_setup.py)
GOOGLE_TOKEN_PATH=/app/credentials/google_token.json

# Calendar polling interval in minutes (for proactive reminders)
CALENDAR_POLL_INTERVAL=5

# Enable tiered countdown alerts (60/30/15/5 min before events)
CALENDAR_TIERED_ALERTS=true

# Tier thresholds in minutes (comma-separated, descending)
CALENDAR_ALERT_TIERS=60,30,15,5

# Morning briefing time (HH:MM, 24-hour format)
MORNING_BRIEFING_TIME=07:30

# Enable/disable morning briefing (default: true)
MORNING_BRIEFING_ENABLED=true

# Evening shutdown ritual (HH:MM + enable flag; tomorrow preview, meds check,
# parks one unfinished thing for the morning briefing to offer back)
EVENING_BRIEFING_TIME=21:30
EVENING_BRIEFING_ENABLED=true

# Sleep wind-down ladder: lights dim at bedtime-60, screens-away nudge at
# bedtime-30. WIND_DOWN_SCENE is a comma-separated list of HA scene.* ids
# (empty = lights rung off). Short nights (goodnight -> morning under the
# threshold) soften the morning briefing.
# NOTE: .env-only changes need `docker compose up -d --force-recreate orchestrator`.
WIND_DOWN_ENABLED=true
WIND_DOWN_BEDTIME=22:30
WIND_DOWN_SCENE=
WIND_DOWN_SHORT_NIGHT_HOURS=6.5

# =============================================================================
# GMAIL CONFIGURATION
# =============================================================================

# Email polling interval in minutes (for proactive new email announcements)
EMAIL_POLL_INTERVAL=30

# Enable/disable email polling (default: true)
EMAIL_POLL_ENABLED=true

# Enable/disable auto-extracting events from emails and adding to calendar
EMAIL_TO_CALENDAR_ENABLED=true

# How often to scan emails for events (minutes, default: 60)
EMAIL_TO_CALENDAR_INTERVAL=60

# =============================================================================
# PHONE CALENDAR SYNC - iPhone Shortcut pushes consolidated calendar
# =============================================================================

# Enable/disable phone calendar sync (default: true)
PHONE_CALENDAR_SYNC_ENABLED=true
# A work-calendar push older than this is treated as stale (default 26h).
PHONE_CALENDAR_MAX_AGE_HOURS=26
# Google Calendar as an event source. Turn off once your calendars live in CalDAV.
CALENDAR_GOOGLE_ENABLED=true

# -- Self-hosted calendar (CalDAV, e.g. Radicale — see docs/CALENDAR.md) --------
# All three of URL/USERNAME/PASSWORD must be set, or CalDAV stays off.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Collection holding the calendars (default /<username>/), optional comma list
# of calendar ids/names to read, and the calendar new events are written to.
CALDAV_CALENDAR_HOME=
CALDAV_CALENDARS=
CALDAV_DEFAULT_CALENDAR=
# Link the dashboard calendar card opens (e.g. Radicale's web UI). Empty = no link.
CALENDAR_WEB_URL=

# =============================================================================
# VISION / IMAGE RECOGNITION - Dedicated vision model on Saturn
# =============================================================================

# Enable/disable vision (image analysis) feature
VISION_ENABLED=true

# Vision model URL — point at your vision-capable model server (e.g.
# http://${NODE_SATURN_IP}:8010/v1 if you run it on a separate GPU box).
# Leave empty to disable vision; the orchestrator will skip image analysis.
VISION_MODEL_URL=

# Vision model name
VISION_MODEL_NAME=Qwen2.5-VL-7B-Instruct-q4_k_m.gguf

# Maximum image upload size in bytes (default: 10MB)
VISION_MAX_IMAGE_SIZE=10485760

# Vision model request timeout in seconds
VISION_TIMEOUT=120

# =============================================================================
# FINANCE - Actual Budget sync (advanced; finance tools need JESS_ADVANCED=true)
# =============================================================================
# Read-only mirror of recent spending from a self-hosted Actual Budget server
# into the Financial Quest Board. Replaced the YNAB integration (2026-10).
# Leave ACTUAL_SERVER_URL empty to run finance in manual-entry mode.
# Actual on the same host as the orchestrator: use http://host.docker.internal:5006
# (stays on the host; the orchestrator service maps host.docker.internal). A
# container name only works if Actual shares the orchestrator's docker network.
# With this repo's actual/docker-compose.yml (loopback-only, joins gateway-net)
# use http://actual-budget:5006 — host.docker.internal does NOT reach it.
ACTUAL_SERVER_URL=
# Actual server password (the one you type on the Actual login screen).
# Wrap it in single quotes if it contains "$" — compose interpolates .env values.
ACTUAL_PASSWORD=
# Budget name exactly as shown in Actual's file list, or its sync id.
# Quote it if it contains a space (ACTUAL_BUDGET_FILE='My Budget') —
# scripts/generate-configs.sh sources .env with bash.
ACTUAL_BUDGET_FILE=
# Only for budgets with end-to-end encryption enabled
ACTUAL_ENCRYPTION_PASSWORD=
# Minutes between syncs (min 5)
