# Copy to /opt/apps/grist/grist.env (chmod 600, owned by labadmin). Never commit
# the real file: it holds the owner's login and the session secret.

# The owner's Tailscale login exactly as Tailscale shows it (Tailscale admin →
# Users, or `tailscale status --json | jq -r '.User[].LoginName'`). This user
# owns every doc; other tailnet users get an empty site.
GRIST_DEFAULT_EMAIL=
GRIST_ADMIN_EMAIL=

# Random secret for session cookies: `openssl rand -hex 32`
GRIST_SESSION_SECRET=
