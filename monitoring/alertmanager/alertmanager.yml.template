# One embedding outage must not send three notices: the boot self-test
# (EmbeddingModelBroken) explains runtime encode() failures, and either one
# explains auto_learn failing (dedup + store need embeddings).
inhibit_rules:
  - source_matchers:
      - alertname="EmbeddingModelBroken"
    target_matchers:
      - alertname=~"EmbeddingErrors|AutoLearnFailing"
  - source_matchers:
      - alertname="EmbeddingErrors"
    target_matchers:
      - alertname="AutoLearnFailing"
  # Saturn down pages as NodeDown; the dead-man's switch on it being
  # unreachable is the same outage, not a second notice.
  - source_matchers:
      - alertname="NodeDown"
    target_matchers:
      - alertname="DeadmanSwitchBroken"
    equal: ["node"]

route:
  receiver: "null"
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # BEGIN deadman — generate-configs.sh strips this block (and the receiver
    # below) unless .env has DEADMAN_WEBHOOK_TOKEN (>= 24 chars).
    # The Watchdog (alert-rules.yml; fires while Jupiter can page) is re-sent
    # about every 2 min (the first flush after repeat_interval has passed, so
    # 2x group_interval) to the dead-man's switch on Saturn (monitoring/deadman/), which pages over
    # its own Pushover when the heartbeats stop — the only page left when this
    # whole box, Docker, or this monitoring stack is down. First and without
    # `continue`, so the Watchdog never reaches a Pushover receiver here.
    - matchers:
        - alertname="Watchdog"
      receiver: "deadman"
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    # END deadman
    # BEGIN self-investigator — generate-configs.sh strips this block (and the
    # receiver below) unless .env has SELF_AUDIT_WEBHOOK_TOKEN (>= 24 chars) AND
    # SELF_AUDIT_INVESTIGATE=true.
    # Copies these alerts to the orchestrator's read-only investigator
    # (POST /api/self_audit/alert); `continue: true` so the normal Pushover
    # route below still matches. Keep the list in sync with ALERT_TRIGGERS in
    # orchestrator/routes_self_audit.py (the orchestrator ignores the rest).
    - matchers:
        - alertname=~"HeliosHardwareFault|ChatStreamTruncating|EmptyRepliesReachingUsers|ToolCallsSilentlyDropped|EmbeddingErrors|AutoLearnFailing|SchedulerJobsMissed|HeliosLogsSilent"
      receiver: "self-investigator"
      continue: true
    # END self-investigator
    # Paging tier: data-at-risk + service-down. JessBackupStale / JessHABackupStale
    # (nightly state + HA config backups) belong here — an unprotected backup is a
    # data-loss window, so it should page like OrchestratorDown, not sit silent on
    # the null receiver.
    #
    # NOTE: routing here is an alertname ALLOW-LIST — the `severity:` label on a
    # rule is decorative and routes nothing. A new rule that is not named in one
    # of these regexes falls through to receiver "null" and notifies NOBODY.
    # LoggingMountMissing pages because losing /mnt/logging kills the Prometheus
    # TSDB and therefore every other alert in this file; it went unnoticed for
    # 3 days on 2026-07-15 precisely because nothing was watching the watcher.
    # HeliosPoweredButUnreachable pages because NodeDown excludes the
    # power-tiered Helios; it is the plug-aware "Helios is hung" signal.
    # UPSOnBattery / UPSLowBattery page: grid power is gone or the battery is
    # about to run out. Until 2026-10-21 no UPS* alert was routed at all, so
    # they all fell through to "null" — the UPS exporter sat dead for three
    # months unnoticed.
    - matchers:
        - alertname=~"UPSOnBattery|UPSLowBattery|OrchestratorDown|NodeDown|MorningBriefingStale|EveningBriefingStale|GoogleTokenRefreshStale|SchedulerJobsMissed|JessBackupStale|JessHABackupStale|JessCalendarBackupStale|JessActualBackupStale|JessGristBackupStale|LoggingMountMissing|DocumentsMountMissing|MediaMountMissing|EmbeddingModelBroken|ClosetTemperatureCritical|HeliosPoweredButUnreachable"
      receiver: "pushover"
    # Non-paging tier: comfort-feature staleness that should surface without
    # a priority-1 page at midnight. Same Pushover creds, priority 0 (respects
    # quiet hours, no emergency retry). JessBackupOffboxFailing (severity: info,
    # 3-day window — local backups are fine, only off-box redundancy is down) is
    # informational, so it surfaces here rather than paging.
    - matchers:
        - alertname=~"WindDownNudgeStale|JessBackupOffboxFailing|ChatStreamTruncating|EmptyRepliesReachingUsers|ToolCallsSilentlyDropped|BudgetSyncFailing|BudgetHistoryRefreshFailing|RadicaleDown|ActualDown|GristDown|FrontendDown|CalendarSourceFailing|SelfAuditStale|SelfAuditFailing|SelfInvestigatorFailing|HeliosHardwareFault|BrainCudaInitFailed|BrainFailedToStart|BrainOnCPU|HeliosGpuDriverBroken|HeliosLogsSilent|HeliosLogCheckFailing|EmbeddingErrors|AutoLearnFailing|ClosetTemperatureSensorMissing|WebPushFailing|SearXNGDown|UPSExporterDown|UPSReplaceBattery|UPSOverload|HAUnrequestedCallsBlocked|ResearchHelperFailing|ResearchSourceFailing|PaperlessDown|DeadmanSwitchBroken"
      receiver: "pushover-quiet"
    # A dead speaker is a physical fix that stays broken for days; speakers
    # get hit all day, so the default 4h repeat would nag 4-5x daily. Once a
    # day is enough.
    - matchers:
        - alertname="AnnouncementSpeakerUnavailable"
      receiver: "pushover-quiet"
      repeat_interval: 24h
    # WebSearchFailing stays active until its failures age out of the 6h
    # window, so the default 4h repeat would re-notify after the fix.
    - matchers:
        - alertname="WebSearchFailing"
      receiver: "pushover-quiet"
      repeat_interval: 24h
    # Helios unreachable with stale/unknown plug reads: the outage detector is
    # blind, a config or HA fix — once a day is enough.
    - matchers:
        - alertname="HeliosUnreachablePlugBlind"
      receiver: "pushover-quiet"
      repeat_interval: 24h
    # A stale work-calendar sync needs the owner to fix the iPhone Shortcut —
    # once a day is enough, like the dead-speaker notice.
    - matchers:
        - alertname="ExchangeCalendarSyncStale"
      receiver: "pushover-quiet"
      repeat_interval: 24h
receivers:
  - name: "null"
  # BEGIN deadman
  # Off-box (Saturn, LAN). The token file is written by generate-configs.sh
  # from DEADMAN_WEBHOOK_TOKEN; Saturn's /etc/jupiter-deadman.env holds the
  # same value. send_resolved: false — the Watchdog only "resolves" when
  # Prometheus stops, and silence is exactly what Saturn watches for.
  - name: "deadman"
    webhook_configs:
      - url: "http://${DEADMAN_HOST}:${DEADMAN_PORT}/heartbeat"
        send_resolved: false
        max_alerts: 1
        timeout: 10s
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/deadman_webhook_token
  # END deadman
  # BEGIN self-investigator
  # Same path Prometheus uses to scrape the orchestrator (its published,
  # bearer-gated port) — Alertmanager stays off gateway-net. The token file is
  # written by generate-configs.sh from SELF_AUDIT_WEBHOOK_TOKEN; the
  # orchestrator accepts that token on /api/self_audit/alert only.
  - name: "self-investigator"
    webhook_configs:
      - url: "http://${NODE_JUPITER_IP}:${SERVICE_ORCHESTRATOR_PORT}/api/self_audit/alert"
        send_resolved: false
        max_alerts: 20
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/self_audit_webhook_token
  # END self-investigator
  - name: "pushover"
    pushover_configs:
      - user_key: ${PUSHOVER_USER_KEY}
        token: ${PUSHOVER_APP_TOKEN}
        title: "Jess alert: {{ .CommonLabels.alertname }} ({{ .Status }})"
        message: "{{ range .Alerts }}{{ .Annotations.summary }} {{ end }}"
        priority: 1
        send_resolved: true
  - name: "pushover-quiet"
    pushover_configs:
      - user_key: ${PUSHOVER_USER_KEY}
        token: ${PUSHOVER_APP_TOKEN}
        title: "Jess notice: {{ .CommonLabels.alertname }} ({{ .Status }})"
        message: "{{ range .Alerts }}{{ .Annotations.summary }} {{ end }}"
        priority: 0
        send_resolved: true
