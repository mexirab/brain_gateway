# /etc/jupiter-deadman.env on SATURN — mode 0600, owner root.
# Read by systemd for jupiter-deadman.service. Never commit the real file.

# Shared secret: the SAME value as DEADMAN_WEBHOOK_TOKEN in Jupiter's .env.
# At least 24 characters. Generate one with:  openssl rand -hex 24
DEADMAN_WEBHOOK_TOKEN=

# Pushover credentials used to page you. Best: a separate Pushover
# application (e.g. "Jupiter dead-man") so its token can be revoked on its own;
# your user key is the same one Jupiter uses.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Who may connect at all: Jupiter's LAN address (Alertmanager's heartbeats
# and Prometheus's scrapes both come from it). Loopback is always allowed.
# Everyone else is dropped on accept. Default: DEADMAN_TARGET_HOST.
DEADMAN_ALLOW_FROM=10.0.0.248

# Start with true: pages are logged to the journal instead of sent. Set to
# false once heartbeats arrive (see README), then restart the service.
DEADMAN_DRY_RUN=true

# --- Optional (defaults shown) ---
# DEADMAN_LISTEN_ADDR=0.0.0.0
# DEADMAN_LISTEN_PORT=9466
# Page after this many seconds without a heartbeat (Alertmanager sends one
# about every 2 min).
# DEADMAN_HEARTBEAT_MAX_AGE_SECONDS=600   (300..86400)
# DEADMAN_CHECK_INTERVAL_SECONDS=60       (10..120)
# Re-page every N hours while Jupiter stays silent.
# DEADMAN_REPEAT_HOURS=4
# What to probe on Jupiter for the page's diagnosis (http(s):// or tcp://).
# DEADMAN_TARGET_HOST=10.0.0.248
# DEADMAN_PROBES=orchestrator=http://10.0.0.248:8888/health,home_assistant=http://10.0.0.248:8123/manifest.json,jupiter_ssh=tcp://10.0.0.248:22
# DEADMAN_PROBE_TIMEOUT_SECONDS=5
