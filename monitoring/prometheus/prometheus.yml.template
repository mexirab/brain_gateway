# Prometheus Configuration for Brain Gateway Cluster
# ==================================================
# TEMPLATE FILE - Do not edit directly!
#
# This file uses environment variable placeholders that are
# substituted by scripts/generate-configs.sh using envsubst.
#
# After editing this template, run:
#   ./scripts/generate-configs.sh
#
# Network Architecture (v7 unified + split deployment):
#
#   Jupiter: ${NODE_JUPITER_IP} (Always-on hub: orchestrator, frontend, Home Assistant,
#                                 monitoring stack — prometheus/grafana/loki/alertmanager,
#                                 Pi-hole primary, conjure API, netdata)
#   Helios:  ${NODE_HELIOS_IP}  (GPU model layer: primary LLM on RTX 5090, TTS/STT + code
#                                 agent on RTX PRO 5000 — power-tiered, asleep most of the time)
#   Saturn:  ${NODE_SATURN_IP}  (Vision model on RTX 3080, expert model on RTX 3090,
#                                 Pi-hole secondary)
#   Uranus:  ${NODE_URANUS_IP}  (ComfyUI/Conjure on 2x RTX 5080)

global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alert-rules.yml

# Alertmanager runs in the same compose project / docker network
# (monitoring/docker-compose.yml), so the bare service name resolves.
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  # ============================================
  # PROMETHEUS SELF-MONITORING
  # ============================================
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          node: 'jupiter'

  # ============================================
  # NODE EXPORTERS - System Metrics
  # ============================================
  - job_name: 'node-exporter'
    static_configs:
      # Jupiter (always-on hub: orchestrator, HA, monitoring stack; no GPU)
      - targets: ['${NODE_JUPITER_IP}:9100']
        labels:
          node: 'jupiter'
          role: 'monitoring'

      # Helios (Gateway + primary LLM + TTS/STT)
      - targets: ['${NODE_HELIOS_IP}:9100']
        labels:
          node: 'helios'
          role: 'gateway'
          gpu: 'rtx5090+rtx-pro-5000'

      # Uranus (ComfyUI / Conjure on 2x RTX 5080)
      - targets: ['${NODE_URANUS_IP}:9100']
        labels:
          node: 'uranus'
          role: 'comfyui'
          gpu: '2x-rtx5080'

      # Saturn (off-box backup target; vision + Pi-hole retired 2026-09)
      - targets: ['${NODE_SATURN_IP}:9100']
        labels:
          node: 'saturn'
          role: 'backup'
          gpu: 'rtx3080+rtx3090'

  # ============================================
  # GPU EXPORTERS - NVIDIA Metrics
  # ============================================
  - job_name: 'gpu-exporter'
    static_configs:
      - targets: ['${NODE_HELIOS_IP}:${MONITORING_GPU_EXPORTER_PORT}']
        labels:
          node: 'helios'
          gpu: 'rtx5090+rtx-pro-5000'

      - targets: ['${NODE_URANUS_IP}:${MONITORING_GPU_EXPORTER_PORT}']
        labels:
          node: 'uranus'
          gpu: '2x-rtx5080'

      - targets: ['${NODE_SATURN_IP}:${MONITORING_GPU_EXPORTER_PORT}']
        labels:
          node: 'saturn'
          gpu: 'rtx3080+rtx3090'

  # ============================================
  # CONJURE API METRICS
  # ============================================
  # Conjure runs as a bare PM2 process on Jupiter (port 5050).
  - job_name: 'conjure'
    scrape_interval: 15s
    static_configs:
      - targets: ['${NODE_JUPITER_IP}:5050']
        labels:
          service: 'conjure-api'
          node: 'jupiter'

  # ============================================
  # PRIMARY LLM SERVER METRICS (llama-server --metrics, Helios GPU0)
  # ============================================
  # llamacpp:* counters: requests_deferred / requests_processing (the --parallel 1
  # queue — the one failure mode the 2026-10-02 llama.cpp cutover introduced),
  # spec-decode draft/accepted tokens (MTP acceptance), prompt_tokens_cached_total
  # vs prompt_tokens_total (prompt-cache hit ratio; this build does NOT export
  # kv_cache_usage_ratio). Helios is power-tiered and asleep most of the day, so
  # this target is down most of the time by design — same posture as the Helios
  # node-exporter/gpu-exporter targets: dashboard signal only, no target-down alert.
  - job_name: 'llama-primary'
    scrape_interval: 30s
    static_configs:
      - targets: ['${NODE_HELIOS_IP}:8080']
        labels:
          node: 'helios'
          service: 'llama-primary'

  # ============================================
  # HTTP HEALTH PROBES (Blackbox Exporter)
  # ============================================
  - job_name: 'blackbox-http'
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      # Brain Gateway Orchestrator (Jupiter — moved off Helios with power-tiering)
      - targets: ['http://${NODE_JUPITER_IP}:${SERVICE_ORCHESTRATOR_PORT}/health']
        labels:
          service: 'orchestrator'
          node: 'jupiter'

      # TTS (Qwen3-TTS on Helios GPU1) — rollback target once VoxCPM2 is live
      - targets: ['http://${NODE_HELIOS_IP}:${SERVICE_TTS_PORT}/health']
        labels:
          service: 'tts'
          node: 'helios'

      # TTS (VoxCPM2 on Helios GPU1, tts/voxcpm-tts.service; /health 503s with no usable voice)
      - targets: ['http://${NODE_HELIOS_IP}:8004/health']
        labels:
          service: 'tts-voxcpm'
          node: 'helios'

      # STT (Whisper on Helios GPU1)
      - targets: ['http://${NODE_HELIOS_IP}:${SERVICE_STT_PORT}/health']
        labels:
          service: 'stt'
          node: 'helios'

      # Primary LLM (llama-server-primary on Helios GPU0 RTX 5090)
      - targets: ['http://${NODE_HELIOS_IP}:8080/v1/models']
        labels:
          service: 'llama-primary'
          node: 'helios'

      # Conjure API (PM2 on Jupiter)
      - targets: ['http://${NODE_JUPITER_IP}:5050/health']
        labels:
          service: 'conjure'
          node: 'jupiter'

      # Actual Budget (docker on Jupiter). tier=app is load-bearing: the
      # AppDown alert keys on probe_success{tier="app"} == 0 (Grafana
      # visibility only — AppDown is not in the Pushover route); ActualDown
      # keys on service=actual. Probed by container name over monitoring-net
      # (Actual publishes only on 127.0.0.1).
      - targets: ['http://actual-budget:5006/health']
        labels:
          service: 'actual'
          node: 'jupiter'
          tier: 'app'

      # Dashboard (Next.js). /login is public (no auth) and served by the app
      # itself, so a 200 proves the server renders pages. Probed by container
      # name over frontend-probe-net (the frontend may publish on 127.0.0.1
      # only). It does NOT cover the Tailscale Serve hop or the publish
      # address. No tier label, so AppDown doesn't double up. FrontendDown
      # keys on service=frontend.
      - targets: ['http://brain-frontend:3001/login']
        labels:
          service: 'frontend'
          node: 'jupiter'

    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # Radicale (self-hosted CalDAV on Jupiter). Own job because it needs the
  # HTTP/1.0-tolerant module. Probed by container name over monitoring-net
  # (Radicale publishes only on 127.0.0.1). RadicaleDown keys on service=radicale.
  - job_name: 'blackbox-http10'
    metrics_path: /probe
    params:
      module: [http_2xx_http10]
    static_configs:
      - targets: ['http://radicale:5232/.web/']
        labels:
          service: 'radicale'
          node: 'jupiter'
          tier: 'app'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # ============================================
  # BRAIN GATEWAY ORCHESTRATOR METRICS
  # ============================================
  - job_name: 'orchestrator'
    metrics_path: /metrics
    scrape_interval: 15s
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/api_token
    static_configs:
      - targets: ['${NODE_JUPITER_IP}:${SERVICE_ORCHESTRATOR_PORT}']
        labels:
          service: 'orchestrator'
          node: 'jupiter'

  # ============================================
  # UPS METRICS (NUT exporter on Helios)
  # ============================================
  # The UPS is USB-attached to Helios; the NUT systemd service reads it
  # and the nut_exporter Docker container exposes /ups_metrics on port 9199.
  # The exporter requires `?ups=<name>` per scrape, so we use relabeling to
  # turn the static targets into URL params and tag each series with `ups`.
  #
  # Goldenmate 2000VA LiFePO4 only exposes status + battery charge/runtime —
  # no load watts or voltages from firmware. Helios's wall draw comes from its
  # Tapo smart plug instead (bgw_helios_plug_watts via the orchestrator).
  - job_name: 'nut'
    metrics_path: /ups_metrics
    scrape_interval: 15s
    static_configs:
      # CyberPower CP1500 retired 2026-10-21 (no longer attached to Helios).
      - targets: ['goldenmate']
        labels:
          node: 'helios'
    relabel_configs:
      - source_labels: [__address__]
        target_label: ups
      - source_labels: [__address__]
        target_label: __param_ups
      - target_label: __address__
        replacement: '${NODE_HELIOS_IP}:9199'

  # ============================================
  # NETDATA - Detailed System Metrics
  # ============================================
  - job_name: 'netdata'
    metrics_path: /api/v1/allmetrics
    params:
      format: [prometheus]
    honor_labels: true
    scrape_interval: 30s
    static_configs:
      - targets: ['${NODE_JUPITER_IP}:19999']
        labels:
          node: 'jupiter'
          source: 'netdata'
      - targets: ['${NODE_SATURN_IP}:19999']
        labels:
          node: 'saturn'
          source: 'netdata'
      - targets: ['${NODE_URANUS_IP}:19999']
        labels:
          node: 'uranus'
          source: 'netdata'
      - targets: ['${NODE_HELIOS_IP}:19999']
        labels:
          node: 'helios'
          source: 'netdata'
