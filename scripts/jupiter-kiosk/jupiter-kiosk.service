# Closet monitors kiosk on Jupiter: Grafana + the Jess dashboard on the two portrait monitors.
# Install steps, config and troubleshooting: scripts/jupiter-kiosk/README.md.
#
# kiosk.py, which starts one Chrome per monitor, against the X server of jupiter-kiosk-x.service.
# This is the unit to enable, start, stop and restart: X comes up first (BindsTo= + After=), and
# follows this unit's stops and restarts (its PartOf=). X dies: this unit stops too (BindsTo=).
#
# X runs in its own network namespace, so the abstract socket the NVIDIA X driver always binds can't
# be reached from the host's (jupiter-kiosk-x.service header). This unit stays in the host network
# namespace, because Chrome loads the pages over Jupiter's Tailscale address. It shares only X's
# private /tmp (JoinsNamespaceOf= + PrivateTmp=), where the X socket is. No PrivateNetwork= here:
# with it, this unit would join X's namespace instead.
#
# Everything runs as the unprivileged `kiosk` user: no sudo, no docker group. PAMName gives it a
# logind session (no seat: that one is X's), for XDG_RUNTIME_DIR and the user's D-Bus. Side effect:
# pam_systemd moves the processes into the kiosk user's session scope, so cgroup limits (memory,
# tasks, CPU, IP allow-list) live in user-<uid>.slice.d/50-jupiter-kiosk.conf, not here. Everything
# below is applied at exec time and does reach kiosk.py and Chrome.

[Unit]
Description=Closet monitors kiosk (Chrome on the display RTX 5080)
Documentation=file:///home/labadmin/gateway_nerves/scripts/jupiter-kiosk/README.md
After=systemd-user-sessions.service network-online.target tailscaled.service
Wants=network-online.target
BindsTo=jupiter-kiosk-x.service
After=jupiter-kiosk-x.service
JoinsNamespaceOf=jupiter-kiosk-x.service
# kiosk.py waits for monitors itself; anything else that ends it is worth retrying forever.
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
PAMName=jupiter-kiosk
StandardOutput=journal
StandardError=journal
# kiosk.py and Chrome log from the session scope: `journalctl -t jupiter-kiosk -t jupiter-kiosk-x`
# shows them with X.
SyslogIdentifier=jupiter-kiosk
# start-x.sh's display. kiosk.py finds the X auth cookie next to it in $XDG_RUNTIME_DIR.
Environment=DISPLAY=:0
ExecStartPre=/usr/local/lib/jupiter-kiosk/kiosk.py --preflight
ExecStart=/usr/local/lib/jupiter-kiosk/kiosk.py
Restart=always
RestartSec=30

# X's /tmp (JoinsNamespaceOf=): the X socket, and nothing from the host's /tmp.
PrivateTmp=yes
# The voice card's device files (bus 0b: /dev/nvidia0, card0, renderD128; check with
# `ls -l /dev/dri/by-path`). Chrome then can't even open it; --preflight fails if these names ever
# point at the display card. Plus host folders the kiosk has no business reading: other apps' data,
# some of it world-readable (Paperless index, Immich, configs under /opt).
InaccessiblePaths=-/dev/nvidia0 -/dev/dri/card0 -/dev/dri/renderD128
InaccessiblePaths=-/mnt -/home -/root -/srv -/opt/conjure -/opt/homepage -/opt/apps
# Chrome sandboxes itself with user namespaces (allowed by Ubuntu's AppArmor `chrome` profile), not
# its setuid helper, so no-new-privileges is fine. Not here: MemoryDenyWriteExecute (V8),
# PrivateDevices (GPU), RestrictNamespaces (Chrome's sandbox), ProtectHome (hides /run/user).
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=graphical.target
