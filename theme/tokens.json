{
  "_comment": "Single source of truth for the Jess suite look (dashboard + Homepage + Home Assistant + Grist). Edit here, then run: python3 theme/build.py. Never hand-edit the generated files (frontend/src/styles/tokens.css, theme/dist/*). Colors are hex; 'dark' is the original Jess palette (2026-06-14), 'light' is its daytime counterpart (every light text/status/accent color clears WCAG AA 4.5:1 on every light surface and on its own 10-20% badge tint).",
  "name": "Jess Suite",
  "font": {
    "sans": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14,
    "xl": 20
  },
  "themes": {
    "dark": {
      "scheme": "dark",
      "brand": { "DEFAULT": "#6f63ff", "hover": "#5d50f0", "50": "#eef0ff", "600": "#5d50f0", "700": "#4a3fd6" },
      "on-brand": "#ffffff",
      "surface": { "base": "#0b0c12", "raised": "#14151f", "overlay": "#1d1e2b", "inset": "#07080d" },
      "content": { "primary": "#edecf2", "secondary": "#aaa9b8", "muted": "#84838f" },
      "ink": "#ffffff",
      "line": { "subtle": 0.05, "DEFAULT": 0.09, "strong": 0.15 },
      "status": { "success": "#34d399", "warning": "#fbbf24", "danger": "#fb7185", "info": "#60a5fa" },
      "accent": { "gold": "#f5c451", "violet": "#a78bfa", "cyan": "#34d3e0", "flame": "#fb7c4d" },
      "glow": 0.08,
      "shadow": {
        "card": "0 1px 2px rgba(0,0,0,0.30), 0 8px 24px -12px rgba(0,0,0,0.55)",
        "glow": "0 0 0 1px rgba(111,99,255,0.20), 0 8px 30px -8px rgba(111,99,255,0.35)"
      }
    },
    "light": {
      "scheme": "light",
      "brand": { "DEFAULT": "#4f43d9", "hover": "#4338ca", "50": "#eef0ff", "600": "#4338ca", "700": "#3730a3" },
      "on-brand": "#ffffff",
      "surface": { "base": "#f4f4f8", "raised": "#ffffff", "overlay": "#ececf2", "inset": "#ebebf0" },
      "content": { "primary": "#17171f", "secondary": "#4a4957", "muted": "#6a6976" },
      "ink": "#141428",
      "line": { "subtle": 0.06, "DEFAULT": 0.1, "strong": 0.16 },
      "status": { "success": "#03664a", "warning": "#92400e", "danger": "#9f1239", "info": "#1e40af" },
      "accent": { "gold": "#854d0e", "violet": "#6d28d9", "cyan": "#155e75", "flame": "#9a3412" },
      "glow": 0.06,
      "shadow": {
        "card": "0 1px 2px rgba(16,16,40,0.06), 0 8px 24px -12px rgba(16,16,40,0.18)",
        "glow": "0 0 0 1px rgba(79,67,217,0.18), 0 8px 30px -8px rgba(79,67,217,0.28)"
      }
    }
  }
}
