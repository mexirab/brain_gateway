# /etc/systemd/system/llama-server-primary.service
# Primary brain split across GPU0 (RTX 5090) + GPU1 (RTX PRO 5000), port 8080 —
# Qwen3.8-Flash-Next (125B MoE, ~6B active per token, llama.cpp arch `qwen4exp`),
# Unsloth UD-Q3_K_XL GGUF + standalone Q8_0 MTP head + F16 mmproj (vision).
# Live since 2026-10-24, replacing the Qwen3.8-27B Q6_K unit (rollback reference:
# tts/llama-server-primary-27b-q6k.service). Trial + measurements: docs/internal/FLASH_NEXT_TRIAL.md.
# Measured with these flags: 137–140 prose / 174–179 code tok/s (MTP acceptance ~60–93 %),
# warm streaming TTFT 0.4–0.5 s via Jess, load 7–9 s from page cache, 27 s cold.
# REQUIRES Jupiter .env VOICE_THINKING_ENABLED=true: with thinking off on voice turns this
# brain took unrequested Home Assistant actions (4/8 on a voice "tell me a fun fact"; 0/80
# with it on). Nothing enforces the flag (it defaults false), and it is a model-behavior
# mitigation, not a control — the blocking control is a deterministic "did the user ask?"
# gate in front of home_assistant calls (separate change). Never restore an .env from before
# 2026-10-24 while this unit is installed.
#
# Weights in /home/labadmin/models/Qwen3.8-Flash-Next-Unsloth (HF unsloth/Qwen3.8-Flash-Next-GGUF
# @ 766911a6b7369840a91dbcd95f9f997acaab6cd6; `sha256sum -c SHA256SUMS` next to them covers all of these):
#   f2ef4328929d8b8c8930e2856eef52128dd4ce3425302f04bc3c657431cc4c49  UD-Q3_K_XL/...-00001-of-00003.gguf
#   7d230e7c9421d868b89eebaf23033af0ea1a4e046956df00fb156814fb62346e  UD-Q3_K_XL/...-00002-of-00003.gguf
#   21d4f90f9cd7b7c3a1582667c20cb22f7b03de895b88a23bb20aaeaa44f2c199  UD-Q3_K_XL/...-00003-of-00003.gguf
#   58a47d6a216307e9b97172d5bfdc3436a8994b632f5e436b9bb6edf8951da8d1  MTP/mtp-Qwen3.8-Flash-Next-Q8_0.gguf
#   1f7b7f0b984cf065c604360c29c8098362ed61b290db0ff12c6f360bb1a8a980  mmproj-F16.gguf
# Use the STANDALONE MTP file: the "shared" one (mtp-…-shared-Q8_0.gguf) fails on this build
# with "tensor 'token_embd.weight' not found" and the server exits; it is on disk but unused.
#
# Engine: /home/labadmin/llama.cpp-mtp (2026-10-02, has qwen4exp + "Qwen4Exp: add MTP").
# The 28.8 GB n-gram table (per_layer_token_embd) is an input GET_ROWS tensor loaded
# lazily from mmap, so it stays in host RAM / page cache, not VRAM.
#
# Context 262144 (the model's native length) since the Saturn TTS move. Was 65536 from 2026-10-24.
# REQUIRES GPU1 free of the TTS: voxcpm-tts runs on Saturn (tts/voxcpm-tts-saturn.service). With
# VoxCPM2 back on GPU1 (7.4 GiB fresh, grows to ~9.7 GiB) this unit does not fit, and --fit off
# makes the start fail (Loki alert BrainFailedToStart). Never start voxcpm-tts on Helios while this
# unit is installed.
# Memory, measured 2026-11-11 with these flags (synthetic prompts on a :8086 test copy):
#   GPU0 29.1 GiB at load, 29.5 GiB after a 200K-token prompt (2.3 GiB free, 92.7 %);
#   GPU1 42.9 GiB at load, 43.7 GiB after it (4.1 GiB free, 91.4 %).
#   At -ts 44,56 GPU0 runs out of memory at load (on the 862 MiB mmproj), so 40,60 puts 2 more
#   layers on GPU1. 39,61 assigns the same layers: splits move whole layers only.
#   KV is small, because only 12 of 48 layers are full attention: q8_0 K+V 3.2 GiB at 262K, plus
#   0.8 GiB indexer K cache and 0.3 GiB MTP-head KV. The big context-dependent part is the compute
#   buffers (~2.8–3.0 GiB per GPU plus 1.5 GiB for the MTP head at ubatch 512), which scale with
#   -c × -ub. -ub 384 trims them (~0.7 GiB on GPU0, ~1 GiB on GPU1) for a slower long prefill:
#   1436 tok/s at 200K tokens vs 1701 at ubatch 512 (and 1254 at 256).
# Long-context results: planted fact found at 100K and 200K tokens. Decode 88 tok/s at 100K and
# 57 tok/s at 200K context. Short-prompt decode is unchanged (123–128 vs 122–125 tok/s at 64K, same
# prompt). A cold 200K-token prompt takes ~140 s to prefill, longer than the unified loop's 120 s
# per-round timeout. In practice only a very long dashboard chat gets there: client history has no
# size cap. The self-audit investigator's budgets keep it near 45–60K tokens. Repeat rounds hit the
# prompt cache, so only the new tokens are prefilled.
#
# Rollback to 65536 with the TTS back on Helios (~3 min). Helios keeps the old unit as
# /etc/systemd/system/llama-server-primary.service.64k.bak (= this file before the change):
#   1. Helios: sudo systemctl stop llama-server-primary
#      sudo cp /etc/systemd/system/llama-server-primary.service.64k.bak /etc/systemd/system/llama-server-primary.service
#      sudo systemctl daemon-reload && sudo systemctl enable --now voxcpm-tts
#      (voxcpm-tts's ExecStartPre refuses to start while a " -c 262144 " unit is installed, so copy
#      the .bak first)
#      wait for `curl -fs http://127.0.0.1:8004/health`, then sudo systemctl start llama-server-primary
#   2. Jupiter: TTS_URL=http://10.0.0.195:8004 in .env, then
#      docker compose up -d --force-recreate orchestrator.
#   3. Repo: point the tts-voxcpm probe back at ${NODE_HELIOS_IP} with node 'helios'
#      (prometheus.yml.template). TTSDown gates on the probe's own node, so it needs no change.
#
# Rollback to the 27B: see the header of tts/llama-server-primary-27b-q6k.service.
#
# Same rules as before: --parallel 1 keeps the MTP gain; temperature <= 1.0 and
# repeat_penalty 1.0 for MTP; keep --chat-template-kwargs reasoning_effort=low (voice turns
# with VOICE_THINKING_ENABLED=true send no kwarg, so this flag sets their thinking depth) and
# --reasoning-format auto (keeps reasoning out of `content`). If output garbles, first lever
# is --spec-type none. Never add --verbose or --slot-save-path: both would put prompt text
# (medical facts, conversations) into the journal / on disk. The startup warning about
# "preserving reasoning" is harmless: Jess never sends reasoning back in history.
# --fit off: every placement arg is set explicitly; with the default --fit on, a boot that finds
# GPU1 short of memory could silently shrink the setup — off makes it fail loudly instead
# (Loki alert BrainFailedToStart).
#
# Sandbox: as the 27B unit (nologin `llama` user, read-only binds, only NVIDIA device
# nodes — now /dev/nvidia0 AND /dev/nvidia1). Do NOT add MemoryDenyWriteExecute or
# PrivateDevices=yes (both break CUDA). Check with: systemd-analyze security llama-server-primary
#
# API key (2026-10-27 egress audit): --api-key-file makes every path except /health answer 401
# without `Authorization: Bearer <key>`, including /v1/models and /metrics. The ExecStartPre
# check refuses to start on a key file with no key line: llama-server skips empty/`#` lines and
# would run with NO auth, silently.
# Enable / rotate (generate the key ONCE, on Jupiter; never pass it as a command argument):
#   1. Jupiter: MODEL_API_KEY=<openssl rand -hex 32> in .env (no quotes; don't set
#      FALLBACK_MODEL_API_KEY: model_auth sends MODEL_API_KEY to the shared origin), then
#      `docker compose up -d --force-recreate orchestrator` and `scripts/generate-configs.sh &&
#      scripts/reload-monitoring.sh` (CI only re-renders when monitoring files change).
#      A key this server doesn't require yet is ignored, so step 1 is safe on its own.
#   2. Helios, from the Jupiter checkout:
#      grep '^MODEL_API_KEY=' .env | cut -d= -f2- | ssh labadmin@10.0.0.195 'umask 077; cat > ~/.llama-api-key.tmp'
#      then on Helios: sudo install -d -m 750 -o root -g llama /etc/llama-server &&
#      sudo install -m 640 -o root -g llama ~/.llama-api-key.tmp /etc/llama-server/api-key &&
#      shred -u ~/.llama-api-key.tmp
#      then `sudo systemctl restart voxcpm-tts`: its InaccessiblePaths=-/etc/llama-server only
#      applies if the directory existed when it started (it runs as the same `llama` user).
#   3. Install this unit (and refresh llama-server-primary.service.27b-q6k.bak from
#      tts/llama-server-primary-27b-q6k.service so a rollback keeps the key), daemon-reload,
#      restart. Check: curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/v1/models -> 401.
# Rotating without an outage: the key file takes one key per line and accepts any of them.
# Append the new key as a second line on Helios and restart the brain, switch MODEL_API_KEY in
# .env + recreate the orchestrator + re-render monitoring, then drop the old line and restart
# again. Changing .env first instead makes the brain look asleep (BrainAuthRejected) until
# Helios catches up.
# Other clients of :8080 need the key too: the `qwen` CLI wrapper on Jupiter
# (~/.local/bin/qwen). A wrong key looks like "Helios asleep"; alerts BrainAuthRejected and
# BrainMetricsScrapeRejected catch it. The key crosses the LAN in plain HTTP: it stops callers
# without it, not someone reading LAN traffic.
[Unit]
Description=llama.cpp primary — Qwen3.8-Flash-Next UD-Q3_K_XL MTP (GPU0+GPU1 split, port 8080)
After=network-online.target nvidia-persistenced.service
Wants=network-online.target
Conflicts=vllm-primary.service

[Service]
Type=simple
Restart=on-failure
RestartSec=10
# Loads in 7–9 s from page cache, 27 s cold from NVMe. Must exceed the readiness loop
# below (240 × ≥1 s) so a stuck load fails as "readiness check failed", not a start timeout.
TimeoutStartSec=360
Environment=CUDA_VISIBLE_DEVICES=0,1

User=llama
Group=llama
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/labadmin/llama.cpp-mtp/build/bin /home/labadmin/models/Qwen3.8-Flash-Next-Unsloth
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia1 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
# Host-firewall substitute (ufw is inactive on Helios): loopback, LAN, tailnet
# CGNAT range, and the Docker bridge ranges for any on-box container client.
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8 10.0.0.0/24 100.64.0.0/10 172.16.0.0/12

ExecStart=/home/labadmin/llama.cpp-mtp/build/bin/llama-server \
  -m /home/labadmin/models/Qwen3.8-Flash-Next-Unsloth/UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00001-of-00003.gguf \
  --mmproj /home/labadmin/models/Qwen3.8-Flash-Next-Unsloth/mmproj-F16.gguf \
  -md /home/labadmin/models/Qwen3.8-Flash-Next-Unsloth/MTP/mtp-Qwen3.8-Flash-Next-Q8_0.gguf \
  -devd CUDA1 -ngld all -ctkd q8_0 -ctvd q8_0 \
  --alias qwen3.8-flash-next-q3kxl \
  --host 0.0.0.0 --port 8080 \
  --no-webui --no-slots --metrics \
  --api-key-file /etc/llama-server/api-key \
  -ngl 999 -fa on \
  -sm layer -ts 40,60 \
  -c 262144 -ub 384 --cache-type-k q8_0 --cache-type-v q8_0 \
  --parallel 1 \
  --spec-type draft-mtp --spec-draft-n-max 2 \
  --jinja --chat-template-kwargs '{"reasoning_effort":"low"}' \
  --reasoning-format auto \
  --fit off

# Refuse to start without a real key line (see the API key note in the header).
ExecStartPre=/usr/bin/grep -qvE '^[[:space:]]*(#.*)?$$' /etc/llama-server/api-key

# Ready check: wait up to 240 s for /health (503 while loading, 200 when ready). Not /v1/models:
# with --api-key-file that path needs the key, and /health is the one path that doesn't. Gives up at
# once if the server process has died (kill -0 on the main PID), instead of curling a dead port
# for the whole window, and stays quiet in the journal. `$$` is a literal `$` for bash: bash reads
# MAINPID from the environment systemd gives ExecStartPost. A bare `$MAINPID` would be expanded
# (to nothing) by systemd itself and fail the start on the first loop.
ExecStartPost=/bin/bash -c "end=$$((SECONDS+240)); while ((SECONDS<end)); do kill -0 $$MAINPID 2>/dev/null || exit 1; curl -fs --max-time 2 http://127.0.0.1:8080/health >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1"

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
