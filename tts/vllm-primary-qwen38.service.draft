# Qwen3.8-27B NVFP4 primary brain (vLLM) for Helios GPU0 — RTX 5090 32 GB
# =========================================================================
# DRAFT — NOT DEPLOYED. Written 2026-09-26 on Jupiter while Helios was
# unplugged, so the live `vllm-primary.service` on Helios could NOT be
# inspected. This unit is modelled on the docker-run pattern documented for it
# (CLAUDE.md: "wraps `docker run vllm/vllm-openai:v0.19.1`, port 8080, pinned
# to GPU0") plus tts/nemotron-vllm.service for the systemd scaffolding. Diff it
# against the real /etc/systemd/system/vllm-primary.service before using it.
#
# Deliberately a SEPARATE unit on a SEPARATE port (8085, not 8080) so it can
# run alongside the existing Qwen3.6 unit during the acceptance test, per
# docs/internal/LOCAL_SINGLE_BOX_PLAN.md "Deploy steps" step 4. Cut
# MODEL_URL/MODEL_NAME over only after the tool-calling test passes; the old
# unit and weights stay on disk as the rollback.
#
# Install (from Jupiter, once Helios is awake):
#   scp tts/vllm-primary-qwen38.service.draft \
#       labadmin@helios.tail74fc4a.ts.net:/tmp/vllm-primary-qwen38.service
#   ssh labadmin@helios.tail74fc4a.ts.net \
#       'sudo mv /tmp/vllm-primary-qwen38.service /etc/systemd/system/ \
#        && sudo systemctl daemon-reload \
#        && sudo systemctl start vllm-primary-qwen38'
#   # note: NOT `enable`d — this is a trial unit until it replaces the 3.6 one.
#
# Weights must already be on Helios at ${MODEL_DIR} below. They are currently
# staged on JUPITER at /home/labadmin/models/Qwen3.8-27B-NVFP4 (RadixArk,
# revision 319f741cce68d7914884900c138a1fbb70a42f30, 20.44 GiB, 22 files):
#   rsync -av --progress /home/labadmin/models/Qwen3.8-27B-NVFP4/ \
#       labadmin@helios.tail74fc4a.ts.net:/home/labadmin/models/Qwen3.8-27B-NVFP4/
#
# Config rationale (short version; full version in
# docs/internal/QWEN38_PREP_RESULTS.md):
#   * fp8 KV + MTP, NOT the 262K `turboquant_4bit_nc` + MTP community config.
#     vLLM PR #40914, which the 262K config depends on, is still OPEN and is in
#     no released vLLM; issue #53180 (open, filed against stock 0.27.1) reports
#     TurboQuant + speculative decoding silently corrupting output on exactly
#     this model class (hybrid GDN — Qwen3.8-27B is 48 linear + 16 full
#     attention layers) and recommends "fp8 KV + MTP (clean) or TurboQuant
#     without spec-dec (clean)". Silent corruption is the worst failure mode
#     for a tool-calling assistant, so this unit takes the clean pairing.
#   * --enforce-eager is REQUIRED per the vLLM recipe for this checkpoint on a
#     single 5090 (CUDA-graph capture OOMs at 32 GB), and it also sidesteps the
#     capture-time corruption in #40880/#53180.
#   * --max-model-len 32768 is the recipe's verified single-card figure with
#     fp8 KV. Raising it is the first thing to retune once it boots.
#   * --default-chat-template-kwargs '{"reasoning_effort":"low"}': the Qwen3.8
#     chat template defaults reasoning_effort to **xhigh**. Left at the default
#     every non-voice turn pays a very long think phase before emitting any
#     content — the same failure that forced `enable_thinking: false` on the
#     voice path (see orchestrator/unified_loop.py:523-536).
#   * No --language-model-only: Qwen3.8 is natively multimodal and the plan
#     restores `analyze_image` by repointing VISION_* at the brain. Drop this
#     and add --language-model-only if VRAM turns out to be tight.

[Unit]
Description=Qwen3.8-27B NVFP4 Brain Model (vLLM 0.27.x on RTX 5090 / GPU0) — TRIAL
Documentation=https://recipes.vllm.ai/Qwen/Qwen3.8-27B
Documentation=file:///opt/gateway_mvp/docs/internal/QWEN38_PREP_RESULTS.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=labadmin
Group=labadmin
WorkingDirectory=/home/labadmin

# Trial port. The live Qwen3.6 unit owns 8080; 8085 lets both run at once.
Environment="VLLM_PORT=8085"
Environment="VLLM_IMAGE=vllm/vllm-openai:v0.27.1"
Environment="CONTAINER_NAME=vllm-primary-qwen38"
Environment="MODEL_DIR=/home/labadmin/models/Qwen3.8-27B-NVFP4"
Environment="SERVED_NAME=qwen3.8-27b-nvfp4"

ExecStartPre=-/usr/bin/docker rm -f ${CONTAINER_NAME}

ExecStart=/usr/bin/docker run --rm --name ${CONTAINER_NAME} \
    --gpus '"device=0"' \
    --ipc=host \
    --shm-size 16g \
    --security-opt no-new-privileges:true \
    -p 0.0.0.0:${VLLM_PORT}:8000 \
    -v ${MODEL_DIR}:/model:ro \
    -v /home/labadmin/.cache/huggingface:/root/.cache/huggingface \
    -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    -e VLLM_USE_FLASHINFER_SAMPLER=0 \
    ${VLLM_IMAGE} \
    --model /model \
    --served-model-name ${SERVED_NAME} \
    --quantization auto \
    --max-model-len 32768 \
    --gpu-memory-utilization 0.93 \
    --kv-cache-dtype fp8 \
    --max-num-seqs 2 \
    --enforce-eager \
    --speculative-config '{"method":"mtp","num_speculative_tokens":3}' \
    --enable-auto-tool-choice \
    --tool-call-parser qwen3_xml \
    --reasoning-parser qwen3 \
    --default-chat-template-kwargs '{"reasoning_effort":"low"}' \
    --enable-prefix-caching \
    --skip-mm-profiling \
    --host 0.0.0.0 \
    --port 8000

ExecStop=/usr/bin/docker stop -t 60 ${CONTAINER_NAME}

Restart=on-failure
RestartSec=30
# NVFP4 load + eager warmup from local disk; no download, but generous anyway.
TimeoutStartSec=900
TimeoutStopSec=90

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vllm-primary-qwen38

Nice=-5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
