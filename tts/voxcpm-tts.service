# VoxCPM2 TTS server (cloned voice + per-utterance style notes) — Helios.
#
# The live voice (TTS_URL :8004). qwen-tts.service (port 8002) is the rollback, DISABLED since
# 2026-10-24: GPU1 also holds half of the Flash-Next brain, so there is no room for both TTS
# servers. Rollback = enable qwen-tts (only with the 27B brain back, see
# tts/llama-server-primary-27b-q6k.service) and repoint TTS_URL at :8002.
#
# Install on Helios (one-time):
#   mkdir -p ~/voxcpm && cd ~/voxcpm
#   ~/.uv-pkg/bin/uv venv --python-preference only-managed --python 3.11 .venv
#     # uv-managed Python, NOT /usr/bin/python3.11: torch.compile (on by default)
#     # needs Python.h, and Helios has no python3.11-dev.
#   VIRTUAL_ENV=$PWD/.venv ~/.uv-pkg/bin/uv pip install --index-strategy unsafe-best-match \
#     --extra-index-url https://download.pytorch.org/whl/cu128 "torch==2.8.*" "torchaudio==2.8.*" \
#     "voxcpm==2.0.3" "fastapi==0.143.2" "uvicorn==0.54.0"
#   cp <repo>/tts/voxcpm_server.py ~/voxcpm/
#   # Weights as real files (the HF cache's blob symlinks under 0700 ~/.cache don't
#   # resolve inside the sandbox):
#   hf download openbmb/VoxCPM2 --revision 32279effe8c19989596f05d353d1447f51d9e915
#   mkdir -p ~/models/VoxCPM2 && cp -L ~/.cache/huggingface/hub/models--openbmb--VoxCPM2/snapshots/32279eff*/* ~/models/VoxCPM2/
#   # Runs as the nologin `llama` user (same as llama-server-primary): every path it
#   # reads must be world-readable —
#   chmod -R o+rX ~/voxcpm ~/tts-voices ~/.local/share/uv/python ~/models/VoxCPM2
#   sudo cp <repo>/tts/voxcpm-tts.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now voxcpm-tts
#
# Weights: openbmb/VoxCPM2 (Apache-2.0), HF revision 32279effe8c19989596f05d353d1447f51d9e915,
# at /home/labadmin/models/VoxCPM2, loaded offline. sha256:
#   model.safetensors f7f964cfa9da23653baec6e6f7750719977ad944ed9f95fe52fe3a620506891d
#   audiovae.pth      94b5d51e107e0507d4acc976cfdadb64edd6fd06d1f751dadbf2fd1594274bf1
# Measured on the RTX PRO 5000: ~0.4-1.3 s per sentence, ~7.4 GiB resident on GPU1.
# torch.compile kernels persist in /var/cache/voxcpm (NOT /tmp, which Helios wipes
# at boot), so only the very first start compiles from scratch.
# Logs: journalctl -u voxcpm-tts (Helios journals are not shipped to Loki).

[Unit]
Description=VoxCPM2 TTS Server for Brain Gateway
After=network.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10
# Load ~12 s from a warm page cache; cold NVMe + first torch.compile is longer.
TimeoutStartSec=300

# GPU1 (RTX PRO 5000) — GPU0 is the 5090 holding the brain.
Environment="CUDA_VISIBLE_DEVICES=1"
Environment="HF_HUB_OFFLINE=1"
Environment="VOXCPM_MODEL=/home/labadmin/models/VoxCPM2"
Environment="VOXCPM_VOICES_DIR=/home/labadmin/tts-voices"
Environment="VOXCPM_PORT=8004"
Environment="VOXCPM_OUTPUT_SR=24000"
# Writable state (torch.compile / triton kernels, any library home-dir cache)
# lives in /var/cache/voxcpm; everything under /home is read-only binds.
CacheDirectory=voxcpm
Environment="HOME=/var/cache/voxcpm"
Environment="TORCHINDUCTOR_CACHE_DIR=/var/cache/voxcpm/inductor"
Environment="TRITON_CACHE_DIR=/var/cache/voxcpm/triton"
Environment="XDG_CACHE_HOME=/var/cache/voxcpm"
# tqdm progress bars per synthesis turn the journal into "[blob data]".
Environment="TQDM_DISABLE=1"
# Peak RSS ~10.4 GiB during load + compile.
MemoryMax=16G

# Sandbox — mirrors llama-server-primary.service. An unauthenticated HTTP
# server on 0.0.0.0 must not run as labadmin (SSH keys, sudo, other checkouts).
User=llama
Group=llama
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/labadmin/voxcpm /home/labadmin/.local/share/uv/python /home/labadmin/tts-voices /home/labadmin/models/VoxCPM2
PrivateTmp=yes
DevicePolicy=closed
# CUDA opens /dev/nvidia0 while enumerating even with CUDA_VISIBLE_DEVICES=1;
# without it torch silently falls back to CPU (~7 s/sentence).
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia1 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
# Host-firewall substitute (ufw is inactive on Helios): loopback, LAN, tailnet,
# Docker bridges (the Wyoming bridge container). Do NOT add
# MemoryDenyWriteExecute or PrivateDevices — both break CUDA.
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8 10.0.0.0/24 100.64.0.0/10 172.16.0.0/12

WorkingDirectory=/home/labadmin/voxcpm
ExecStart=/home/labadmin/voxcpm/.venv/bin/python /home/labadmin/voxcpm/voxcpm_server.py

StandardOutput=journal
StandardError=journal
SyslogIdentifier=voxcpm-tts

[Install]
WantedBy=multi-user.target
